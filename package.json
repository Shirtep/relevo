{
  "name": "relevo",
  "displayName": "Relevo",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "a-shirtep",
  "author": {
    "name": "Shirtep"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shirtep/relevo.git"
  },
  "bugs": {
    "url": "https://github.com/Shirtep/relevo/issues"
  },
  "homepage": "https://github.com/Shirtep/relevo#readme",
  "keywords": [
    "claude code",
    "accounts",
    "multi-account",
    "usage",
    "quota",
    "switcher"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "*",
    "onWebviewPanel:claudeVSCodePanel",
    "onView:claudeVSCodeSidebar",
    "onView:claudeVSCodeSidebarSecondary",
    "onView:claudeVSCodeSessionsList",
    "onCommand:claude-vscode.editor.open",
    "onCommand:claude-vscode.editor.openLast",
    "onCommand:claude-vscode.primaryEditor.open",
    "onCommand:claude-vscode.window.open",
    "onCommand:claude-vscode.createWorktree",
    "onCommand:claude-vscode.sidebar.open",
    "onCommand:claude-vscode.newConversation",
    "onCommand:claude-vscode.reopenClosedSession",
    "onCommand:claude-vscode.update",
    "onCommand:claude-vscode.focus",
    "onCommand:claude-vscode.focusLastMessage",
    "onCommand:claude-vscode.blur",
    "onCommand:claude-vscode.logout",
    "onCommand:claude-vscode.terminal.open",
    "onCommand:claude-vscode.acceptProposedDiff",
    "onCommand:claude-vscode.rejectProposedDiff",
    "onCommand:claude-vscode.acceptProposedHunk",
    "onCommand:claude-vscode.rejectProposedHunk",
    "onCommand:claude-vscode.acceptProposedHunkFromBar",
    "onCommand:claude-vscode.rejectProposedHunkFromBar",
    "onCommand:claude-vscode.insertAtMention",
    "onCommand:claude-vscode.installPlugin",
    "onCommand:claude-code.acceptProposedDiff",
    "onCommand:claude-code.rejectProposedDiff",
    "onCommand:claude-code.insertAtMentioned",
    "onCommand:claude-vscode.showLogs",
    "onCommand:claude-vscode.toggleFocusView",
    "onCommand:claude-vscode.openWalkthrough",
    "onCommand:claude-vscode.markSessionUnread",
    "onCommand:claude-vscode.renameSessionTab",
    "onCommand:claude-vscode.addSessionTabToGroup",
    "onWalkthrough:claude-code-walkthrough",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "relevo.switch",
        "title": "%command.switch%",
        "category": "Relevo"
      },
      {
        "command": "relevo.addAccount",
        "title": "%command.addAccount%",
        "category": "Relevo"
      },
      {
        "command": "relevo.removeAccount",
        "title": "%command.removeAccount%",
        "category": "Relevo"
      },
      {
        "command": "relevo.showUsage",
        "title": "%command.showUsage%",
        "category": "Relevo"
      },
      {
        "command": "relevo.updateUsage",
        "title": "%command.updateUsage%",
        "category": "Relevo"
      },
      {
        "command": "relevo.setupProfiles",
        "title": "%command.setupProfiles%",
        "category": "Relevo"
      },
      {
        "command": "relevo.diagnostics",
        "title": "%command.diagnostics%",
        "category": "Relevo"
      },
      {
        "command": "relevo.reportProblem",
        "title": "%command.reportProblem%",
        "category": "Relevo"
      }
    ],
    "configuration": {
      "title": "Relevo",
      "properties": {
        "relevo.accounts": {
          "type": "array",
          "markdownDescription": "%config.accounts%",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.accounts.id%"
              },
              "label": {
                "type": "string",
                "description": "%config.accounts.label%"
              },
              "configDir": {
                "type": "string",
                "description": "%config.accounts.configDir%"
              }
            }
          },
          "scope": "application"
        },
        "relevo.defaultAccount": {
          "type": "string",
          "default": "A",
          "description": "%config.defaultAccount%",
          "scope": "application"
        },
        "relevo.sharedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "projects"
          ],
          "markdownDescription": "%config.sharedFolders%",
          "scope": "application"
        },
        "relevo.refreshIntervalMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "%config.refreshIntervalMinutes%",
          "scope": "application"
        },
        "relevo.statusBarUsage": {
          "type": "string",
          "enum": [
            "active",
            "off"
          ],
          "enumDescriptions": [
            "%config.statusBarUsage.active%",
            "%config.statusBarUsage.off%"
          ],
          "default": "active",
          "scope": "application",
          "description": "%config.statusBarUsage%"
        },
        "relevo.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "default": "auto",
          "scope": "application",
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Español"
          ],
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "sync-activation": "node scripts/sync-activation-events.js",
    "package": "vsce package --allow-star-activation",
    "test:e2e": "node e2e/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
